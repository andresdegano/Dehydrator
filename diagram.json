{
  "version": 1,
  "author": "Arduino Dehydrator Project",
  "title": "Arduino Dehydrator with DHT22, 3 Status LEDs & LCD Display",
  "description": "Simulated Arduino Uno with DHT22 sensor, 3 status LEDs (Hot Fan, Cold Fan, Heater), 2 push buttons, and LCD 1602 I2C display",
  "parts": [
    {
      "type": "wokwi-arduino-uno",
      "id": "uno",
      "top": 0,
      "left": 0,
      "attrs": {
        "name": "Arduino Uno"
      }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": 100,
      "left": 300,
      "attrs": {
        "name": "DHT22 Sensor"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 300,
      "left": 300,
      "attrs": {
        "name": "Hot Air Fan LED (Pin 8)",
        "color": "red"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 280,
      "left": 250,
      "attrs": {
        "name": "R1",
        "resistance": "220Ω"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led2",
      "top": 400,
      "left": 300,
      "attrs": {
        "name": "Cold Air Fan LED (Pin 9)",
        "color": "blue"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 380,
      "left": 250,
      "attrs": {
        "name": "R2",
        "resistance": "220Ω"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led3",
      "top": 500,
      "left": 300,
      "attrs": {
        "name": "Electric Heater LED (Pin 10)",
        "color": "yellow"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r3",
      "top": 480,
      "left": 250,
      "attrs": {
        "name": "R3",
        "resistance": "220Ω"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 200,
      "left": 600,
      "attrs": {
        "name": "Button UP (Pin 2)"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn2",
      "top": 250,
      "left": 600,
      "attrs": {
        "name": "Button DOWN (Pin 3)"
      }
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd1",
      "top": 100,
      "left": 700,
      "attrs": {
        "name": "LCD 1602 (I2C)",
        "pins": "I2C"
      }
    }
  ],
  "connections": [
    [
      "uno:GND.1",
      "dht1:GND",
      "black",
      []
    ],
    [
      "uno:7",
      "dht1:SDA",
      "green",
      []
    ],
    [
      "uno:5V",
      "dht1:VCC",
      "red",
      []
    ],
    [
      "uno:8",
      "r1:1",
      "orange",
      []
    ],
    [
      "r1:2",
      "led1:A",
      "orange",
      []
    ],
    [
      "led1:C",
      "uno:GND.1",
      "black",
      []
    ],
    [
      "uno:9",
      "r2:1",
      "blue",
      []
    ],
    [
      "r2:2",
      "led2:A",
      "blue",
      []
    ],
    [
      "led2:C",
      "uno:GND.1",
      "black",
      []
    ],
    [
      "uno:10",
      "r3:1",
      "purple",
      []
    ],
    [
      "r3:2",
      "led3:A",
      "purple",
      []
    ],
    [
      "led3:C",
      "uno:GND.1",
      "black",
      []
    ],
    [
      "uno:2",
      "btn1:1",
      "red",
      []
    ],
    [
      "btn1:2",
      "uno:5V",
      "red",
      []
    ],
    [
      "uno:3",
      "btn2:1",
      "red",
      []
    ],
    [
      "btn2:2",
      "uno:5V",
      "red",
      []
    ],
    [
      "uno:A4",
      "lcd1:SDA",
      "green",
      []
    ],
    [
      "uno:A5",
      "lcd1:SCL",
      "yellow",
      []
    ],
    [
      "uno:5V",
      "lcd1:VCC",
      "red",
      []
    ],
    [
      "uno:GND.1",
      "lcd1:GND",
      "black",
      []
    ]
  ]
}
